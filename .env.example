# Copy this to .env for local dev (already gitignored), or set these as
# environment variables in your hosting provider's dashboard for deploy.

# The one shared password for the whole site (visitors + admin, for now).
SITE_PASSWORD=change-me

# Random secret used to sign the login session cookie. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=change-me-too
